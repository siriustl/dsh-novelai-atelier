{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2024"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true,
    "declaration": false
  },
  "include": ["src/**/*.ts"]
}
